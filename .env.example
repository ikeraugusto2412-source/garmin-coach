# Copia este archivo a .env y rellena tus credenciales de Garmin Connect.
GARMIN_EMAIL=tu_email@ejemplo.com
GARMIN_PASSWORD=tu_contraseña

# Opcional: dónde guardar los tokens de sesión (por defecto ~/.garminconnect)
# GARMINTOKENS=~/.garminconnect

# Opcional: ruta de la base de datos (por defecto ./garmin.db)
# GARMIN_DB=./garmin.db

# Opcional: pausa en segundos entre peticiones a Garmin (por defecto 1.0)
# GARMIN_REQUEST_DELAY=1.0

# Carrera objetivo (la web muestra la cuenta atrás y el objetivo)
RACE_NAME=Media Maratón de Barcelona
RACE_DATE=2027-02-14
RACE_DISTANCE_KM=21.0975
RACE_TARGET=1:59:59
RACE_TARGET_OK=2:05:00

# Contraseña de la web (defínela con: python -m garmin_coach web-password)
# WEB_PASSWORD=
